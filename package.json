{
  "name": "agent-code-timer",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "description": "Focus timer extension for Agent Code",
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node dev/test.mjs",
    "test:extension": "node --test testing/extension-contract.test.mjs",
    "verify": "npm test && NODE_ENV=production npm run build && npm run test:extension"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "agent-code-extension-api": "git+https://github.com/Juliusolsson05/agent-code-extension-api.git#96acc8912a8838bcfda306968833b16297c19c18",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0",
    "vite": "^5.4.19"
  }
}
