{
  "id": "timer",
  "name": "Timer",
  "description": "Focus timer with interval reminders. Keeps running when its panel is closed.",
  "version": "0.4.1",
  "apiVersion": 2,
  "entry": "dist/runtime.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "id": "timer.open",
        "title": "Open Timer",
        "keywords": [
          "focus",
          "pomodoro",
          "countdown",
          "clock"
        ]
      },
      {
        "id": "timer.start",
        "title": "Start Timer"
      },
      {
        "id": "timer.pause",
        "title": "Pause Timer"
      },
      {
        "id": "timer.reset",
        "title": "Reset Timer"
      }
    ],
    "views": [
      {
        "id": "timer.main",
        "title": "Timer",
        "mount": "panel",
        "entry": "dist/view.js"
      }
    ],
    "settings": [
      {
        "id": "timer.inheritTheme",
        "title": "Inherit Agent Code theme",
        "type": "boolean",
        "default": false
      },
      {
        "id": "timer.defaultMinutes",
        "title": "Default duration (minutes)",
        "type": "number",
        "default": 30
      }
    ]
  },
  "permissions": [
    "sessions.observe",
    "notifications.show"
  ]
}
